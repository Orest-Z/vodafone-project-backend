# Copy this file to .env and fill in the values.
# .env is never committed — it is listed in .gitignore.

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:<port>/<db>?user=<user>&password=<password>
DB_USERNAME=
DB_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
APP_GAME_HUB_TIMEZONE=Europe/Tirane
APP_FRONTEND_BASE_URL=http://localhost:3000

# ── PassKit ──────────────────────────────────────────────────────────────────
PASSKIT_API_BASE_URL=https://api.pub1.passkit.io
PASSKIT_API_TOKEN=
PASSKIT_PROGRAM_ID=
PASSKIT_TIER_ID=base
PASSKIT_PASS_URL_HOST=https://pub1.pskt.io

# ── Mail (Gmail SMTP) ─────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
